rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acceso a perfiles de usuarios autenticados
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Permitir acceso a los datos de equipos para usuarios autenticados
    match /teams/{teamId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
