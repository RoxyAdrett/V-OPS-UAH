rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    match /teams/{teamId}/coach-notes/{fileName} {
      allow read: if request.auth != null && profile().teamId == teamId;
      allow write: if request.auth != null && profile().teamId == teamId && profile().role == 'coach' && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
